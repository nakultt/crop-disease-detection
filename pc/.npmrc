# better-auth declares ~20 optional framework peers (SvelteKit, TanStack Start,
# Prisma, ...), each with peers of its own. npm 10's resolver crashes walking
# that set ("Cannot read properties of null (reading 'edgesOut')"). Every peer
# this app actually needs is a direct dependency, so skipping automatic peer
# resolution loses nothing. Keep this file: CI and the Dockerfile rely on it.
legacy-peer-deps=true
