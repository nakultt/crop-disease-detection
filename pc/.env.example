# PlantGuard web — configuration
#
# Nothing here is required. With no `.env` file at all, the app runs against
# a local MongoDB (mongodb://127.0.0.1:27017/plantguard), generates and saves
# its own secret in `.data/`, and skips email verification.
#
# To customise, copy this file to `.env.local` and uncomment what you need.
# Values marked SET BEFORE GOING PUBLIC matter once others can reach the app.

# --- Core --------------------------------------------------------------------

# Public URL of the site, no trailing slash. Used for links in emails,
# OAuth callbacks, the sitemap and CSRF origin checks. SET BEFORE GOING PUBLIC.
# APP_URL=http://localhost:3000

# Signs sessions and tokens. At least 32 characters; generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Changing it signs everyone out. If unset, one is generated and saved to
# .data/auth-secret. SET BEFORE GOING PUBLIC.
# BETTER_AUTH_SECRET=

# MongoDB connection string. The database name comes from the path
# (here `plantguard`) unless MONGODB_DB is set. A replica set enables
# multi-document transactions for account changes; a standalone server works
# too.
# MONGODB_URI=mongodb://127.0.0.1:27017/plantguard
# MONGODB_DB=plantguard

# Extra origins allowed to call the API (comma-separated), e.g. a second
# domain that serves the same app. Usually empty.
# TRUSTED_ORIGINS=https://www.example.com

# --- Email -------------------------------------------------------------------
# Verification, password-reset and change-email messages. Configure SMTP for
# real delivery, either as one URL or as separate fields. Without SMTP,
# messages go to MAIL_OUTBOX_DIR as JSON files if set, else to the server log.

# SMTP_URL=smtps://user:password@smtp.example.com:465
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_SECURE=false
# EMAIL_FROM="PlantGuard <no-reply@example.com>"
# MAIL_OUTBOX_DIR=.mail-outbox

# --- Accounts ----------------------------------------------------------------

# Require a verified email before signing in. Off by default so a local
# install needs no email server; turn it on (with SMTP) before going public.
# REQUIRE_EMAIL_VERIFICATION=true

# Close public sign-up; existing accounts keep working.
# DISABLE_SIGNUPS=false

# Accounts with these emails become admins when they sign up (or, with
# verification on, once they verify). Comma-separated. You can also run
# `npm run admin:grant -- you@example.com`.
# ADMIN_EMAILS=you@example.com

# Optional social sign-in. A provider's button appears only when both values
# are set. Callback URLs to register with the provider:
#   {APP_URL}/api/auth/callback/google
#   {APP_URL}/api/auth/callback/github
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# --- Limits ------------------------------------------------------------------

# Saved scans kept per account, and scan saves allowed per user per minute.
# MAX_SCANS_PER_USER=5000
# SCAN_UPLOADS_PER_MINUTE=30

# --- Legal pages and branding -------------------------------------------------

# Shown in the privacy policy, terms and footer.
# COMPANY_NAME=PlantGuard
# SUPPORT_EMAIL=support@example.com

# --- Operations --------------------------------------------------------------

# debug | info | warn | error. Production logs are JSON lines.
# LOG_LEVEL=info
